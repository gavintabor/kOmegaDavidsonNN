FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

vertices
(
    (0.00        0.00        0.000)   // 0
    (75.190209   0.00        0.000)   // 1
    (75.190209   18.022070   0.000)   // 2
    (0.00        18.022070   0.000)   // 3
    (0.00        0.00        0.010)   // 4
    (75.190209   0.00        0.010)   // 5
    (75.190209   18.022070   0.010)   // 6
    (0.00        18.022070   0.010)   // 7
);

blocks
(
    // 150 cells in x (uniform), 90 in y (graded), 1 in z (2D).
    // Reproduces Davidson (2026) Sec. 5.2's flat-plate grid: 150x90 cells,
    // domain 92*delta_in x 20*delta_in, y-grid geometric near the wall
    // (dy0=9.83e-4, r=1.1/cell) up to y=6.354 then uniform to y=18.022 --
    // see cases/flatPlate/generate_inlet_profile.py for how these grading
    // fractions were derived from Davidson's own y2d.dat.
    hex (0 1 2 3 4 5 6 7)
    (150 90 1)
    simpleGrading
    (
        1
        (
            (0.352588 0.755556 539.4078)
            (0.647412 0.244444 1)
        )
        1
    )
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }

    top
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    front
    {
        type empty;
        faces
        (
            (0 3 2 1)
        );
    }

    back
    {
        type empty;
        faces
        (
            (4 5 6 7)
        );
    }
);

