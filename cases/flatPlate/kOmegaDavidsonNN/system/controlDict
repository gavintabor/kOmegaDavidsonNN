FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// kOmegaDavidsonNN needs far more iterations than kOmega to converge here.
// At the flat-plate default ewmaM=500, endTime=15000 was enough (confirmed
// bit-identical between successive writes). With ewmaM=3000 (see
// constant/turbulenceProperties -- adopted to smooth a numerical-stiffness
// kink around Re_theta~4600-4900), the slower coefficient averaging needs
// far longer: still drifting ~7%/500 iterations at 15000, so bumped well
// past that estimate to let it genuinely settle.
endTime         100000;

deltaT          1;

writeControl    timeStep;

writeInterval   2000;

purgeWrite      3;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs            ("libkOmegaDavidsonNN.so");

// ************************************************************************* //
