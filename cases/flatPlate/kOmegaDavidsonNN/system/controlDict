FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// kOmegaDavidsonNN needs far more iterations than kOmega to converge here:
// the near-wall NN coefficients (sigma_k,NN, C_k,NN, C_omega2,NN) were still
// drifting by 15-20% every 500 iterations at endTime=3000. Confirmed
// converged (bit-identical between successive writes) by endTime=15000.
endTime         15000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      3;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs            ("libkOmegaDavidsonNN.so");

// ************************************************************************* //
