FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    RASModel        kOmegaDavidsonNN;

    turbulence      on;

    printCoeffs     on;
}

// Davidson's stated flat-plate default (500). A near-discontinuous ~3x
// collapse in near-wall k occurs around Re_theta~4600-4900 in the fully
// converged solution (see README "Known limitations") -- ewmaM=3000
// (his channel-flow value) was tested at full convergence (100,000
// iterations) and reaches the IDENTICAL converged state, confirming this
// is a genuine steady-state property of the coupled model, not an
// artifact of this averaging window. ewmaM is therefore left at the
// (much cheaper to converge) default.

