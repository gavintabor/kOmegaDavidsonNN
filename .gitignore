# Third-party reference material (Davidson's paper/code) - not for redistribution
/literature/

# Local convenience file (Claude Code session resume command)
/claudeResume

# Redundant backup of the (tracked) src/ directory
/src.zip

# Leftover duplicate download (same 3 files already tracked in cases/NNCheck/)
/cases/files (1).zip

# OpenFOAM build artifacts
src/lnInclude/
src/Make/*/

# Python
__pycache__/
*.pyc

# OpenFOAM run artifacts (all regenerable via Allrun) - solver logs,
# case-generated postProcessing/ function-object output, processor
# directories from parallel runs, and solved time-step directories
# (keep 0/ since it holds the initial/boundary conditions).
log.*
processor*/
postProcessing/
!/postProcessing/
cases/*/*/[0-9]*/
!cases/*/*/0/

# writeCellCentres output, auto-generated into 0/ by the plotting scripts
# on demand -- goes stale (wrong size) if the mesh later changes, so it
# must never be committed (caused a real crash in plotFlatPlate.py when
# the flatPlate mesh was regridded but this was left over from the old one).
cases/*/*/0/C
cases/*/*/0/Cx
cases/*/*/0/Cy
cases/*/*/0/Cz
cases/*/*/0/Cf
