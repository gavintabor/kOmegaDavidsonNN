# Third-party reference material (Davidson's paper/code) - not for redistribution
/literature/

# Local convenience file (Claude Code session resume command)
/claudeResume

# Redundant backup of the (tracked) src/ directory
/src.zip

# Leftover duplicate download (same 3 files already tracked in cases/NNCheck/)
/cases/files (1).zip

# OpenFOAM build artifacts
src/lnInclude/
src/Make/*/

# Python
__pycache__/
*.pyc

# OpenFOAM run artifacts (all regenerable via Allrun) - solver logs,
# case-generated postProcessing/ function-object output, processor
# directories from parallel runs, and solved time-step directories
# (keep 0/ since it holds the initial/boundary conditions; keep 0.orig/
# too -- the periodicHill sub-cases use OpenFOAM's restore0Dir pattern,
# where 0.orig/ is the actual tracked source and 0/ is restored from it
# at the start of every Allrun, so 0.orig/ must not be dropped here).
log.*
processor*/
# `transient`'s own processor0..N are symlinks to ../steadyState/processorN
# (its Allrun links rather than decomposes), and git's trailing-slash
# processor*/ pattern above doesn't match symlinks-to-directories, only
# real directories -- same class of gap already handled for the
# transient_*_2D cases' polyMesh symlink below, just not caught here until
# `transient` was actually run for the first time (2026-08-11).
processor*
postProcessing/
!/postProcessing/
cases/*/*/[0-9]*/
!cases/*/*/0/
!cases/*/*/0.orig/

# dynamicCode/ (codedFixedValue etc. runtime-compiled library cache,
# regenerated by Allrun -- not source data).
dynamicCode/

# periodicHill's 3D mesh (~2.56M cells) is regenerated by blockMesh/topoSet
# on every Allrun like the other cases' meshes, but its polyMesh files
# exceed GitHub's size limits (100MB+) unlike the smaller cases, so it
# can't be tracked the way channelFlow5200/flatPlate/pitzDaily's meshes are.
# (No trailing slash: also matches the transient_*_2D sub-cases' polyMesh,
# which is a symlink to their steady counterpart's mesh rather than a real
# directory, recreated fresh by Allrun every run like their processor*
# links -- same reasoning, not source data.)
cases/periodicHill/*/constant/polyMesh

# writeCellCentres output, auto-generated into 0/ by the plotting scripts
# on demand -- goes stale (wrong size) if the mesh later changes, so it
# must never be committed (caused a real crash in plotFlatPlate.py when
# the flatPlate mesh was regridded but this was left over from the old one).
cases/*/*/0/C
cases/*/*/0/Cx
cases/*/*/0/Cy
cases/*/*/0/Cz
cases/*/*/0/Cf
